    "schema_version": "1.0",
    "page_id": "topic-5-9-4",
    "page_path": "/explore/education/scientific-achievements/registered-technologies/",
    "name": "Registered Technologies",
    "level": 3,
    "parent_path": "/explore/education/scientific-achievements/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
    "email": null,
