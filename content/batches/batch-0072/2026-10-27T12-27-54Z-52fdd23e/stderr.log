  {
    "schema_version": "1.0",
    "page_id": "topic-3-9-6",
    "page_path": "/explore/geography/biodiversity/marine-habitats/",
    "name": "Marine Habitats",
    "level": 3,
    "parent_path": "/explore/geography/biodiversity/",
    "entity_type": "category",
    "address": null,
    "phone": null,
