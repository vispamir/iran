  {
    "schema_version": "1.0",
    "page_id": "topic-10-6-2",
    "page_path": "/explore/society/social-challenges/housing-access/",
    "name": "Housing Access",
    "level": 3,
    "parent_path": "/explore/society/social-challenges/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
    "email": null,
