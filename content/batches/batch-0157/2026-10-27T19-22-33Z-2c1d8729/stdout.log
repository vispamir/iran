  {
    "schema_version": "1.0",
    "page_id": "topic-6-11-1",
    "page_path": "/explore/business/artificial-intelligence/persian-language-processing/",
    "name": "Persian Language Processing",
    "level": 3,
    "parent_path": "/explore/business/artificial-intelligence/",
    "entity_type": "concept",
    "address": null,
