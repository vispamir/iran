    "schema_version": "1.0",
    "page_id": "topic-6",
    "page_path": "/explore/business/",
    "name": "Innovation & Business Opportunities",
    "level": 1,
    "parent_path": "/explore/",
    "entity_type": "category",
    "address": null,
