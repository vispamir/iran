    "schema_version": "1.0",
    "page_id": "topic-14-5-6",
    "page_path": "/explore/media/advertising-and-marketing/advertising-effectiveness/",
    "name": "Advertising Effectiveness",
    "level": 3,
    "parent_path": "/explore/media/advertising-and-marketing/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
