    "schema_version": "1.0",
    "page_id": "topic-11-2",
    "page_path": "/explore/health/medical-services/",
    "name": "Medical Services",
    "level": 2,
    "parent_path": "/explore/health/",
    "entity_type": "category",
    "address": null,
