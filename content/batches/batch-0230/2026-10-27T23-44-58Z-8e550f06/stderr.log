    "description": "Iran’s municipal waste organizations manage services connecting collection, transport, processing, recycling, and disposal. Their responsibilities sit within a legal framework that distinguishes municipal duties from producers’ responsibilities for industrial and special waste. [s1]",
    "tags": ["Waste management", "Municipal services", "Recycling", "Environmental governance"],
    "status": null,
    "editorial_status": "ready_for_review",
    "as_of_date": "2026-10-26",
