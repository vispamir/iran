    "description": "Iran’s public hospital sector includes facilities connected to medical universities and other public institutions. Its organization combines clinical services, public financing, and, in university hospitals, medical training.",
    "tags": ["Public hospitals", "Hospital governance", "Medical education", "Health financing"],
    "status": null,
    "editorial_status": "needs_research",
    "as_of_date": "2026-10-26",
