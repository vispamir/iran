    "schema_version": "1.0",
    "page_id": "topic-6-1-5",
    "page_path": "/explore/business/software-development-infrastructure/software-architecture-consulting/",
    "name": "Software Architecture Consulting",
    "level": 3,
    "parent_path": "/explore/business/software-development-infrastructure/",
    "entity_type": "concept",
    "address": null,
