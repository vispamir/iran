  {
    "schema_version": "1.0",
    "page_id": "topic-2-7-2",
    "page_path": "/explore/culture/food-and-cooking/regional-cuisines/",
    "name": "Regional Cuisines",
    "level": 3,
    "parent_path": "/explore/culture/food-and-cooking/",
    "entity_type": "category",
    "address": null,
