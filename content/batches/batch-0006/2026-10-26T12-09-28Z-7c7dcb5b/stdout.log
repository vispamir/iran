      {
        "id": "s5",
        "title": "Truths and Lies: Irony and Intrigue in the Tārīkh-i Bayhaqī",
        "publisher": "Iranian Studies; Cambridge University Press",
        "url": "https://www.cambridge.org/core/journals/iranian-studies/article/abs/truths-and-lies-irony-and-intrigue-in-the-tarikhi-bayhaqi/45E7A3267985BC550E143C4DB6F8ED47",
        "language": "English",
        "publication_date": null,
