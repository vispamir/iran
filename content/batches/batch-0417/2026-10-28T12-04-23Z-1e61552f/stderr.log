      "interpretation": "A sourced interpretation written only after inspecting the actual values."
    },
    "source_ids": ["s1"]
  },
  {
    "id": "data-table",
    "type": "table",
    "content": {
      "title": "Underlying annual observations",
      "dataset_id": "annual-series"
    },
    "source_ids": ["s1"]
  },
  {
    "id": "relationship-diagram",
