  {
    "schema_version": "1.0",
    "page_id": "topic-3-11-3",
    "page_path": "/explore/geography/human-geography/rural-settlements/",
    "name": "Rural Settlements",
    "level": 3,
    "parent_path": "/explore/geography/human-geography/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
    "email": null,
