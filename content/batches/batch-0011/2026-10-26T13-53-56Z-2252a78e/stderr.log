  {
    "schema_version": "1.0",
    "page_id": "topic-1-5-4",
    "page_path": "/explore/history/modern-political-transformations/the-1953-coup/",
    "name": "The 1953 Coup",
    "level": 3,
    "parent_path": "/explore/history/modern-political-transformations/",
    "entity_type": "event",
    "address": null,
    "phone": null,
    "email": null,
