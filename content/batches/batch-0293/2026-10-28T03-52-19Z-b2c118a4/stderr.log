  {
    "schema_version": "1.0",
    "page_id": "topic-10-1-1",
    "page_path": "/explore/society/demography/population-age-structure/",
    "name": "Population Age Structure",
    "level": 3,
    "parent_path": "/explore/society/demography/",
    "entity_type": "indicator",
    "address": null,
    "phone": null,
    "email": null,
