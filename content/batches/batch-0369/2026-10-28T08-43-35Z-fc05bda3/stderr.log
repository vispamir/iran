  {
    "schema_version": "1.0",
    "page_id": "topic-14-5-1",
    "page_path": "/explore/media/advertising-and-marketing/digital-advertising/",
    "name": "Digital Advertising",
    "level": 3,
    "parent_path": "/explore/media/advertising-and-marketing/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
