  {
    "schema_version": "1.0",
    "page_id": "topic-7-11-6",
    "page_path": "/explore/travel/travel-infrastructure/tourist-transport/",
    "name": "Tourist Transport",
    "level": 3,
    "parent_path": "/explore/travel/travel-infrastructure/",
    "entity_type": "category",
    "address": null,
    "phone": null,
