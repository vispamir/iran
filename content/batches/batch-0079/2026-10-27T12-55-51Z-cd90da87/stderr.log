  {
    "schema_version": "1.0",
    "page_id": "topic-4-1-3",
    "page_path": "/explore/industry/macroeconomics/unemployment/",
    "name": "Unemployment",
    "level": 3,
    "parent_path": "/explore/industry/macroeconomics/",
    "entity_type": "indicator",
    "address": null,
    "phone": null,
    "email": null,
