  {
    "schema_version": "1.0",
    "page_id": "topic-7-7-6",
    "page_path": "/explore/travel/rural-and-nomadic-travel/local-life-experiences/",
    "name": "Local Life Experiences",
    "level": 3,
    "parent_path": "/explore/travel/rural-and-nomadic-travel/",
    "entity_type": "concept",
    "address": null,
