    "schema_version": "1.0",
    "page_id": "topic-6-8-5",
    "page_path": "/explore/business/online-services/home-service-platforms/",
    "name": "Home Service Platforms",
    "level": 3,
    "parent_path": "/explore/business/online-services/",
