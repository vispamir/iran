    "page_id": "topic-1-3-7",
    "page_path": "/explore/history/medieval-iran/ilkhanate/",
    "name": "Ilkhanate",
    "level": 3,
    "parent_path": "/explore/history/medieval-iran/",
    "entity_type": "organization",
    "address": null,
    "phone": null,
    "email": null,
    "website": null,
