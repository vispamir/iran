  "id": "annual-series",
  "title": "Exact indicator title",
  "geography": "Defined geographic scope",
  "population_scope": null,
  "frequency": "annual",
  "calendar": "gregorian",
  "methodology": "Exact definition and comparability notes",
  "series": [
    {
