  {
    "schema_version": "1.0",
    "page_id": "topic-2",
    "page_path": "/explore/culture/",
    "name": "People, Values & Culture",
    "level": 1,
    "parent_path": "/explore/",
    "entity_type": "category",
    "address": null,
