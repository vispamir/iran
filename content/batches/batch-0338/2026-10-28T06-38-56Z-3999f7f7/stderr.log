  {
    "schema_version": "1.0",
    "page_id": "topic-12-6",
    "page_path": "/explore/environment/circular-economy/",
    "name": "Circular Economy",
    "level": 2,
    "parent_path": "/explore/environment/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
