  {
    "schema_version": "1.0",
    "page_id": "topic-12-6-1",
    "page_path": "/explore/environment/circular-economy/plastic-recycling/",
    "name": "Plastic Recycling",
    "level": 3,
    "parent_path": "/explore/environment/circular-economy/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
    "email": null,
