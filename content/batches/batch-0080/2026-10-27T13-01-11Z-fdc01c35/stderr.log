              {"year": 2015, "period_label": "2015", "period_start": null, "period_end": null, "value": 35.3, "observation_status": "estimated", "source_ids": ["s1"], "source_locator": "SIPOVGINIIRN, row 2015-01-01", "note": "Published survey-based estimate; not a forecast."},
