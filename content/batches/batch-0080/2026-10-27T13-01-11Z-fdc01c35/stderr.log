              {"year": 2013, "period_label": "2013", "period_start": null, "period_end": null, "value": 34.0, "observation_status": "estimated", "source_ids": ["s1"], "source_locator": "SIPOVGINIIRN, row 2013-01-01", "note": "Published survey-based estimate; not a forecast."},
