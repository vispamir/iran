  {
    "schema_version": "1.0",
    "page_id": "topic-4-2",
    "page_path": "/explore/industry/oil-and-gas/",
    "name": "Oil & Gas",
    "level": 2,
    "parent_path": "/explore/industry/",
    "entity_type": "category",
    "address": null,
    "phone": null,
    "email": null,
