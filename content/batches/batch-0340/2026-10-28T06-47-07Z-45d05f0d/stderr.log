    "schema_version": "1.0",
    "page_id": "topic-12-6-6",
    "page_path": "/explore/environment/circular-economy/sustainable-product-design/",
    "name": "Sustainable Product Design",
    "level": 3,
    "parent_path": "/explore/environment/circular-economy/",
    "entity_type": "concept",
    "address": null,
    "phone": null,
    "email": null,
