  {
    "schema_version": "1.0",
    "page_id": "topic-17-3-2",
    "page_path": "/explore/mining/chemical-industries/polymers/",
    "name": "Polymers",
    "level": 3,
    "parent_path": "/explore/mining/chemical-industries/",
    "entity_type": "category",
    "address": null,
    "phone": null,
    "email": null,
