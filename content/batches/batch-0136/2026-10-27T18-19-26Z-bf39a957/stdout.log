    "contact_source_ids": ["s1"],
    "description": "Dotin is an Iranian financial-software company whose published portfolio includes banking infrastructure, insurance software and digital financial products. Its core-banking materials describe centralized processing and configurable banking products, while its corporate account also identifies work on Wepod, Bank Pasargad's digital banking service. [s1][s2]",
    "tags": ["Dotin", "Core banking", "Banking software", "Financial technology", "Digital banking"],
    "status": null,
    "editorial_status": "needs_research",
    "as_of_date": "2026-10-26",
