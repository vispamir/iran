    "schema_version": "1.0",
    "page_id": "topic-6-10-4",
    "page_path": "/explore/business/software-delivery-and-operations/secrets-and-cryptographic-key-management/",
    "name": "Secrets & Cryptographic Key Management",
    "level": 3,
    "parent_path": "/explore/business/software-delivery-and-operations/",
    "entity_type": "concept",
    "address": null,
