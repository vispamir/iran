  {
    "schema_version": "1.0",
    "page_id": "topic-1-2-3",
    "page_path": "/explore/history/ancient-persian-empires/sasanian-empire/",
    "name": "Sasanian Empire",
    "level": 3,
    "parent_path": "/explore/history/ancient-persian-empires/",
    "entity_type": "organization",
    "address": null,
    "phone": null,
    "email": null,
